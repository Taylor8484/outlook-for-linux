  <releases>
    <release version="2.1.1" date="2026-09-13">
      <description>
        <ul>
          <li>fail passkey prompts fast when security key support is off</li>
        </ul>
      </description>
    </release>
    <release version="2.1.0" date="2026-09-13">
      <description>
        <ul>
          <li>open mailto: links in an Outlook compose window</li>
          <li>set desktopName so desktops match the window to its launcher</li>
          <li>keep release-please green when no release PR is opened</li>
        </ul>
      </description>
    </release>
    <release version="2.0.0" date="2026-09-13">
      <description>
        <ul>
          <li>Rebased on teams-for-linux 2.21.0 (Electron 43)</li>
          <li>Removed Teams-only features: calls, screen sharing, MQTT, quick chat, custom backgrounds and stickers</li>
          <li>Adds multiple accounts through profiles</li>
          <li>Adds FIDO2 security key and Intune single sign-on support</li>
          <li>Adds download notifications and AppImage auto-update</li>
        </ul>
      </description>
    </release>
  </releases>
